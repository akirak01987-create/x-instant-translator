<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ウィジェット設定"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="このウィジェットに表示する通知の条件を設定してください。"
        android:textColor="#616161"
        android:textSize="13sp" />

    <TextView
        style="@style/SectionLabel"
        android:text="見出し" />

    <EditText
        android:id="@+id/edit_widget_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="例: 重要アカウント"
        android:inputType="text" />

    <TextView
        style="@style/SectionLabel"
        android:text="表示する通知(フィルター設定から複数選択可)" />

    <ListView
        android:id="@+id/list_widget_filters"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:divider="#E0E0E0"
        android:dividerHeight="1dp" />

    <Button
        android:id="@+id/btn_widget_save"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="保存してウィジェットを追加"
        android:textAllCaps="false" />

</LinearLayout>
