<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filter_edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_screen_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/group_filter_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/SectionLabel"
                android:layout_marginTop="0dp"
                android:text="投稿者（@ユーザー名 または 表示名。空欄なら全投稿者）" />
            <EditText
                android:id="@+id/edit_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="例：@example"
                android:inputType="text" />

            <TextView
                style="@style/SectionLabel"
                android:text="本文キーワード（1行に1つ。空欄なら本文条件なし）" />
            <EditText
                android:id="@+id/edit_keywords"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top"
                android:hint="例：速報&#10;地震"
                android:inputType="textMultiLine"
                android:minLines="3" />

            <TextView
                style="@style/SectionLabel"
                android:text="キーワードの一致方法" />
            <RadioGroup
                android:id="@+id/radio_match_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio_any"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="いずれかを含む" />

                <RadioButton
                    android:id="@+id/radio_all"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="すべて含む" />
            </RadioGroup>

            <CheckBox
                android:id="@+id/check_case_sensitive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="大文字と小文字を区別する" />

            <Switch
                android:id="@+id/switch_enabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="このフィルターを有効にする" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:background="#E0E0E0" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_sound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="通知音を鳴らす" />

        <TextView
            style="@style/SectionLabel"
            android:text="通知音の種類" />
        <RadioGroup
            android:id="@+id/radio_sound_option"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Switch
            android:id="@+id/switch_popup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ポップアップ通知を表示する" />

        <Switch
            android:id="@+id/switch_translate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="翻訳する（英語の投稿のみ対象）" />

        <TextView
            style="@style/SectionLabel"
            android:text="アプリ内ツリーの文字色" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/row_text_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/SectionLabel"
            android:text="アプリ内ツリーの背景色" />
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none">
            <LinearLayout
                android:id="@+id/row_bg_colors"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <TextView
            style="@style/SectionLabel"
            android:text="プレビュー" />
        <TextView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:padding="14dp"
            android:text="Xの新しい投稿です（プレビュー表示）"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_delete"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="このフィルターを削除"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="保存"
                android:textAllCaps="false" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
