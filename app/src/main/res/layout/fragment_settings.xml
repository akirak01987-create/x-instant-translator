<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="アプリ設定"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_listener_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="確認中…"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_grant_access"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="通知へのアクセスを許可"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/text_post_permission_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="確認中…"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_app_notification_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Android通知設定を確認（通知が来ない場合はこちら）"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/text_battery_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="確認中…"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_battery_optimization"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="バッテリー最適化の対象から除外する"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="タブレットなど普段あまり触らない端末を長時間放置すると、OSやメーカー独自の省電力機能によってこのアプリが停止させられ、通知が遅れたり届かなくなったりすることがあります。対象から除外しておくことを強くおすすめします。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btn_prepare_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="翻訳モデルを準備"
            android:textAllCaps="false" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Xの元の通知を自動的に消す"
                android:textSize="15sp" />

            <Switch
                android:id="@+id/switch_hide_original"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="オンにすると、翻訳のポップアップを表示するタイミングでXアプリ側の元の通知(英語)を消して、二重に表示されないようにします。ポップアップを表示しないフィルターの投稿には影響しません。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="通知履歴の保存期間（分）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edit_retention_minutes"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:inputType="number" />

            <Button
                android:id="@+id/btn_save_retention"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="保存"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_history_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="通知履歴の文字サイズ（タブレットなど画面が大きい端末向け）" />

        <RadioGroup
            android:id="@+id/radio_history_text_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_text_size_0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="小" />

            <RadioButton
                android:id="@+id/radio_text_size_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="やや小" />

            <RadioButton
                android:id="@+id/radio_text_size_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="標準" />

            <RadioButton
                android:id="@+id/radio_text_size_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="やや大" />

            <RadioButton
                android:id="@+id/radio_text_size_4"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="大" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="既定では、Xの英語投稿を受信した瞬間に端末内で日本語へ翻訳します(外部送信なし)。下記で翻訳エンジンをクラウドAPIに切り替えた場合、投稿本文がそのサービスへ送信されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="翻訳エンジン" />

        <RadioGroup
            android:id="@+id/radio_translation_engine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/radio_engine_on_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="端末内（ML Kit・既定・外部送信なし）" />

            <RadioButton
                android:id="@+id/radio_engine_google"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Google Cloud Translation API" />

            <RadioButton
                android:id="@+id/radio_engine_deepl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="DeepL API" />

            <RadioButton
                android:id="@+id/radio_engine_gemini"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Gemini API" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="クラウドAPIを選ぶ場合は、下記のそれぞれの欄でAPIキーを設定してください。未設定のまま選択すると翻訳に失敗し、原文がそのまま表示されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="Google Cloud Translation APIキー" />

        <EditText
            android:id="@+id/edit_google_translate_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Google Cloud Translation APIキーを入力"
            android:inputType="textPassword"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_save_google_translate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google Cloudコンソールで課金を有効化した上で発行したAPIキーを貼り付けてください。月50万文字までは無料ですが、それを超えると課金されます。無料枠内に収めたい場合はGoogle Cloud Console側で割り当て(クォータ)の上限を設定することをおすすめします。キーは端末内にのみ保存されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="DeepL APIキー（翻訳エンジンで「DeepL API」を選んだ場合に使用）" />

        <EditText
            android:id="@+id/edit_deepl_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="DeepL APIキーを入力"
            android:inputType="textPassword"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_save_deepl"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="DeepL(deepl.com)で発行したAPIキーを貼り付けてください。上記の翻訳エンジンで「DeepL API」を選んだ場合、ここのキーで通知の翻訳を行います。キーは端末内にのみ保存されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="Gemini API（通知の翻訳エンジン、および通知履歴画面の「AI分析」ボタンで共用）" />

        <EditText
            android:id="@+id/edit_gemini_api_key"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Gemini APIキーを入力"
            android:inputType="textPassword"
            android:textIsSelectable="true" />

        <EditText
            android:id="@+id/edit_gemini_model"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="モデル名（例: gemini-2.5-flash）"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_save_gemini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Google AI Studio(aistudio.google.com)で発行したAPIキーを貼り付けてください。上記の翻訳エンジンで「Gemini API」を選んだ場合はここのキーで通知の翻訳を行います。また通知履歴画面の「🤖 AI分析」ボタンからも、表示中(絞り込み中)の投稿をGeminiへ送信してドル円相場に関連しそうな内容を分析させる際に使います。APIキー・モデル名は端末内にのみ保存されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="LINE公式アカウント連携（Messaging APIのチャンネルアクセストークン）" />

        <EditText
            android:id="@+id/edit_line_token"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="チャンネルアクセストークンを入力"
            android:inputType="textPassword"
            android:textIsSelectable="true" />

        <Button
            android:id="@+id/btn_save_line_token"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="保存"
            android:textAllCaps="false" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="LINE Developersコンソールで発行したチャンネルアクセストークン(長期)を貼り付けてください。フィルターごとに「LINE公式アカウントに送信する」をオンにすると、一致した投稿の翻訳文がこの公式アカウントを友だち追加した全員へブロードキャスト配信されます。トークンは端末内にのみ保存されます。"
            android:textColor="#9E9E9E"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="#E0E0E0" />

        <TextView
            style="@style/SectionLabel"
            android:layout_marginTop="0dp"
            android:text="直近の受信ログ（診断用。Xの投稿本文以外は内容を記録しません）" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_refresh_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ログを更新"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/btn_download_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginBottom="8dp"
                android:text="📥 ダウンロード"
                android:textAllCaps="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_raw_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="#424242"
            android:textIsSelectable="true"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
